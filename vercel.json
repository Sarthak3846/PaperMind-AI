
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "papermind-ai-backend": {
      "root": "code/backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "frontend": {
      "root": "code/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "papermind-ai-backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "papermind-ai-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
