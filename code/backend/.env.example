# Copy to .env (never commit .env). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Model used for every LLM call. Check Google's changelog: gemini-2.5-flash is
# scheduled to be re-routed on 1 Dec 2026. Run `python scripts/check_gemini.py` to test.
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: tried automatically if GEMINI_MODEL returns "model not found"
GEMINI_FALLBACK_MODEL=

# Which prompt set to load from /prompts: v1 | v2 | v3 | final
PROMPT_VERSION=final

# Comma-separated list of allowed browser origins (add your Vercel URL when deployed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides
# PAPERMIND_DATASET_DIR=
# LLM_MAX_RETRIES=3
# MAX_PAPERS_PER_QUERY=4
