{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "api/processed_papers.json",
      "excludeFiles": "{node_modules, .git, .next, *.pyc, __pycache__}/**"
    }
  }
}